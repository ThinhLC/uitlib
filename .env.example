# Copy to .env.local and change any value you like.
# The MySQL image reads DB_NAME, DB_USER and the passwords only on the FIRST start of an empty
# volume. After changing them, run `docker compose down -v` and start again.

# Host and port your machine uses to reach MySQL (change DB_PORT if 3306 is taken).
DB_HOST=127.0.0.1
DB_PORT=3306
# Main schema. The test schema is always ${DB_NAME}_test.
DB_NAME=library
# Application account (restricted privileges, granted by scripts/db/grants.ts).
DB_USER=library_app
DB_PASSWORD=change-me
# MySQL root password; root is the owner that runs migrations, grants, test resets and dumps.
MYSQL_ROOT_PASSWORD=change-me-root

# Optional: only for scripts/seed/fetch-google-books.ts.
GOOGLE_BOOKS_API_KEY=

# Supabase (validated by src/env.ts with @t3-oss/env-nextjs; `pnpm dev` refuses to start without them).
# NEXT_PUBLIC_* values are public: Next.js inlines them into the browser bundle for the UI's client.
# Project URL, e.g. https://<ref>.supabase.co. The API derives the JWKS URL and token issuer from it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (Project Settings → API Keys, sb_publishable_…). Used by the UI's Supabase client
# and by the /api/v1/auth/callback and /api/v1/auth/confirm redirects. Never put a secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_change-me
# Optional: secret of the Supabase "Before User Created" HTTP hook (format v1,whsec_...).
# Leave unset to disable the hook route; accounts are then created on the first API request.
# AUTH_HOOK_SECRET=
