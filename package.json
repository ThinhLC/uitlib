{
  "name": "nexuslib",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose --env-file .env.local up -d --wait db",
    "db:spike": "tsx scripts/db/spike.ts",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:grants": "tsx scripts/db/grants.ts",
    "db:reset-test": "tsx scripts/db/reset-test.ts",
    "db:check": "tsx scripts/db/check.ts",
    "db:objects": "tsx scripts/db/objects.ts",
    "db:seed": "tsx scripts/seed/seed.ts",
    "db:report": "tsx scripts/db/report.ts",
    "db:ddl": "tsx scripts/db/ddl.ts",
    "db:explain": "tsx scripts/db/explain.ts",
    "db:backup": "tsx scripts/db/backup.ts",
    "db:restore": "tsx scripts/db/restore.ts",
    "db:dictionary": "tsx scripts/db/dictionary.ts",
    "erd:relational": "tsx scripts/erd/relational.ts",
    "erd:render": "bash scripts/erd/render.sh",
    "test:db": "vitest run tests/db",
    "test:concurrency": "vitest run tests/concurrency",
    "test:api": "vitest run tests/api",
    "test:bypass": "for i in $(seq 1 20); do echo \"run $i/20\"; vitest run tests/db -t 'B-[1-5][: ]' || exit 1; done",
    "db:down": "docker compose --env-file .env.local down"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@date-fns/tz": "1.5.0",
    "@date-fns/utc": "2.1.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "@t3-oss/env-nextjs": "0.13.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "4.4.0",
    "dotenv": "^18.0.2",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "4.13.8",
    "jose": "6.2.12",
    "lodash-es": "4.18.1",
    "lucide-react": "^1.48.0",
    "mysql2": "^3.24.4",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "standardwebhooks": "1.1.1",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/lodash-es": "4.17.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
